---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout locale="en">
  <section class="page-shell hero">
    <div class="hero-copy">
      <p class="terminal-prompt"><span>adrien@platform</span>:~$ whoami<span class="cursor" aria-hidden="true"></span></p>
      <h1>Platform Engineer<span>Cloud-native architecture, from design to production.</span></h1>
      <p class="hero-lead">I design, automate and secure Kubernetes platforms and their cloud foundations. Six years of experience turning business requirements into reliable, observable and straightforward architectures.</p>
      <ul class="stack-line" aria-label="Core skills">
        <li><span class="status-dot"></span>Kubernetes</li>
        <li>Linux</li>
        <li>GitOps</li>
        <li>Cloud Architecture</li>
        <li>AWS</li>
      </ul>
      <div class="hero-actions">
        <a class="button primary" href="/en/experience/">View my experience <span aria-hidden="true">→</span></a>
        <a class="button" href="/en/articles/">Read my articles</a>
      </div>
      <p class="hero-footnote"><span aria-hidden="true">//</span> Nantes, France · UTC+2</p>
    </div>
    <div class="hero-profile">
      <div class="profile-bar"><span>profile.yaml</span><span class="profile-dots" aria-hidden="true">● ● ●</span></div>
      <img src="/img/avatar-clean.png" alt="Portrait of Adrien Parra" width="1254" height="1254" fetchpriority="high" />
      <div class="profile-status"><span><i></i>Available</span><code>6y uptime</code></div>
    </div>
  </section>
</BaseLayout>
